{
  "info": {
    "_postman_id": "b2b2c8c8-4198-4b78-926b-14b9e0c6d4e2",
    "name": "Cenario 2 - Criar Postagem",
    "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains a token and assign its value to the variable token\", function () {",
                  "    const rawToken = pm.response.text();",
                  "    pm.expect(rawToken).to.be.a('string').that.is.not.empty;",
                  "    pm.collectionVariables.set(\"token\", rawToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{BASE_URL}}:{{PORT}}/flop/auth/login"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Postagem",
      "item": [
        {
          "name": "cadastrar",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": {
                "token": "{{token}}"
              }
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"praiaId\": {{praiaId}},\n  \"mensagem\": \"{{mensagemPost}}\",\n  \"longitudeUser\": -48.5057429,\n  \"latitudeUser\": -27.7039016\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{BASE_URL}}:{{PORT}}/flop/postagens/cadastrar"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost"
    },
    {
      "key": "PORT",
      "value": "8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}